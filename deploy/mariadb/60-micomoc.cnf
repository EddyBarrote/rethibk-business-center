# MICOMOC — MariaDB (escrito por deploy/provision.sh; não editar no servidor, editar no repositório).
# Só ouve em local; utf8mb4; buffer do InnoDB a 1/4 da RAM.
[mysqld]
bind-address                   = 127.0.0.1
skip-name-resolve
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci
default_storage_engine         = InnoDB
innodb_file_per_table          = 1
innodb_buffer_pool_size        = @@INNODB_BUFFER_POOL@@
innodb_log_file_size           = 256M
innodb_flush_log_at_trx_commit = 1
# Horizon (até 33 processos), PHP-FPM e agendador, com folga.
max_connections                = 200
# Emails grandes e o texto completo dos ficheiros do Conhecimento.
max_allowed_packet             = 256M
slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/mariadb-slow.log
long_query_time                = 2
