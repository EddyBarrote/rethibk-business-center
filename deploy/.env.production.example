# MICOMOC — .env de produção (e de staging). docs/DEPLOY.md explica cada bloco.
#
# deploy/provision.sh copia este ficheiro para /var/www/micomoc/shared/.env na primeira vez e
# preenche sozinho: APP_ENV, APP_URL, TENANCY_CENTRAL_DOMAIN, VITE_REVERB_HOST, DB_*, APP_KEY e
# REVERB_APP_*. O resto completa-se à mão. Nunca pôr este ficheiro com valores no repositório.
#
# Depois de mudar o .env: `sudo deploy/deploy.sh <ref>` (ou, sem código novo,
# `php artisan optimize` e `sudo supervisorctl restart micomoc:*`). As variáveis VITE_* entram no
# JavaScript ao compilar: mudá-las pede um deploy.

APP_NAME="Rethink.OS"
# production, ou staging no servidor de testes (o Horizon tem processos para os dois).
APP_ENV=production
# Gerada pelo provision.sh. Decifra as palavras-passe das caixas, os tokens do ERP e as chaves de
# IA guardadas na base de dados: perdê-la é perder esses dados. Guardar também num cofre.
# Rodar: a antiga passa para APP_PREVIOUS_KEYS (separadas por vírgulas) e a nova para APP_KEY.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
# O domínio central, em https. Dá o esquema dos links dos tenants e o regresso do Google.
APP_URL=https://plataforma.example.co.mz

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Tenancy -------------------------------------------------------------------------------
# Cada tenant fica em {slug}.TENANCY_CENTRAL_DOMAIN; a consola do super admin em admin.<central>.
TENANCY_CENTRAL_DOMAIN=plataforma.example.co.mz
TENANCY_ADMIN_DOMAIN=

# --- Proxy à frente do Nginx ---------------------------------------------------------------
# Vazio: o Nginx fala com o PHP-FPM directamente e o IP de cada pedido é o verdadeiro.
# Só com Cloudflare (proxy laranja) ou um balanceador à frente: os IPs dele, separados por
# vírgulas (ou * se só ele chega ao servidor). Sem isto, o limite de tentativas de login
# trataria todas as pessoas como um só IP.
TRUSTED_PROXIES=

# --- Registos --------------------------------------------------------------------------------
# Um ficheiro por dia em storage/logs, guardados 30 dias.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de dados (MariaDB 11.8, só em 127.0.0.1) ------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micomoc
DB_USERNAME=micomoc
DB_PASSWORD=

# --- Redis: filas, cache e sessões ------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
# Acima do trabalho mais longo (SyncErpSales, 900 s): antes disto um trabalho a meio seria
# entregue a um segundo processo. É também o valor por omissão de config/queue.php.
REDIS_QUEUE_RETRY_AFTER=930
CACHE_STORE=redis
FILESYSTEM_DISK=local

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null: o cookie é só do host. Nunca ".<domínio>": a sessão passaria entre tenants.
SESSION_DOMAIN=null
# Cookies só por HTTPS (também é a omissão quando APP_URL começa por https).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Tempo real (Reverb atrás do Nginx) -----------------------------------------------------
BROADCAST_CONNECTION=reverb
# Gerados pelo provision.sh (o mesmo que `php artisan reverb:install`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Onde o processo do Reverb ouve (o Supervisor passa também --host e --port).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Por onde o Laravel publica os eventos: directo ao Reverb, sem sair do servidor.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Por onde o browser se liga: wss://ws.<central>:443, que o Nginx passa ao Reverb.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.plataforma.example.co.mz
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Horizon -------------------------------------------------------------------------------
# Quem abre /horizon (num host de tenant, com a sessão desse tenant): emails separados por vírgulas.
HORIZON_ALLOWED_EMAILS=

# --- Email da própria plataforma (recuperar palavra-passe, avisos) ---------------------------
# Uma caixa do Hostinger. As caixas dos agentes e das pessoas configuram-se na aplicação.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Entrada de email (IMAP, mail:fetch a cada minuto) --------------------------------------
# Bruto e anexos mais antigos do que isto apagam-se (mail:prune); cada empresa pode mudar.
MAIL_RETENTION_DAYS=365
MAIL_MAX_MESSAGE_BYTES=41943040
MAIL_MAX_ATTACHMENT_BYTES=20971520

# --- IA -------------------------------------------------------------------------------------
# Provedor e modelo por omissão; cada agente escolhe o seu na aplicação. As chaves podem ficar
# aqui (valem para todas as empresas) ou em Definições › Provedores de IA (por empresa, cifradas).
AI_PROVIDER=gemini
AI_MODEL=
# Os vectores do Conhecimento são do Gemini (768 dimensões). Mudar de provedor de embeddings
# pede `php artisan knowledge:reindex`.
AI_EMBEDDINGS_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
AI_PROVIDER_RETRIES=3
AI_PROVIDER_RETRY_DELAY_MS=1500
# Preço de segurança (USD por milhão de tokens) para modelos sem preço em config/agents.php.
AI_FALLBACK_INPUT_USD_PER_MTOK=15
AI_FALLBACK_OUTPUT_USD_PER_MTOK=75
AI_SUGGESTIONS_MODEL=gemini-3.1-flash-lite
AI_WEB_SEARCH_PROVIDER=gemini
AI_WEB_SEARCH_MODEL=
AI_WEB_SEARCH_FEE_USD=0.014
AGENTS_DISCOVER_MODELS=true
AGENTS_THOUGHT_SUMMARIES=true
AGENTS_SCHEDULE_TIMEZONE=Africa/Maputo
ATTACHMENTS_TRANSCRIPTION_PROVIDER=
KNOWLEDGE_READING_PROVIDER=
KNOWLEDGE_READING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=768
KNOWLEDGE_MAX_UPLOAD_MB=100

# --- Caixa do code.run (Docker) -------------------------------------------------------------
# docker: contentor sem rede, só de leitura, como nobody (imagem de docker/sandbox, construída
# em cada deploy). off: code.run desligado e os agentes usam files.analyze.
AI_CODE_SANDBOX=docker
AI_CODE_DOCKER_IMAGE=micomoc-sandbox
AI_CODE_TIMEOUT=60
AI_CODE_MEMORY_MB=1024
AI_CODE_MAX_MB=50

# --- ERP (MCP por HTTPS) ----------------------------------------------------------------------
# Cada empresa liga o seu ERP em Definições › Integrações › ERP (URL e token cifrado). Estes
# valores só servem a empresa sem ligação própria. "local" arranca o ERP falso: só em staging.
ERP_MCP_TRANSPORT=web
ERP_MCP_URL=
ERP_MCP_TOKEN=
ERP_MCP_TIMEOUT=30
ERP_FAKE_STORAGE_PATH=

# --- Google Calendar por pessoa ---------------------------------------------------------------
# Cliente OAuth «Aplicação Web» com a Google Calendar API activa. URI de redireccionamento
# autorizado: https://<central>/oauth/google/callback. Vazio: a opção não aparece.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Regras de negócio por omissão (cada empresa muda na consola) ------------------------------
BUSINESS_SLA_HOURS=24

# --- Tenant Rethink (só se este servidor o tiver: php artisan db:seed --class=RethinkSeeder) ---
# No servidor da MICOMOC ficam vazios e o seed não se corre.
RETHINK_ERP_URL=
RETHINK_ERP_TOKEN=
RETHINK_OWNER_PASSWORD=
