APP_NAME="Plataforma de Agentes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://micomoc.localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

# Tenants are served from {slug}.TENANCY_CENTRAL_DOMAIN (e.g. micomoc.localhost)
TENANCY_CENTRAL_DOMAIN=localhost
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micomoc_agents
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Comma-separated platform operators allowed to open /horizon outside local
HORIZON_ALLOWED_EMAILS=

# IA — [CONFIRMAR] provedor e modelo (docs/SPEC.md secção 21, #3)
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=

# ERP (E01)
ERP_MCP_TRANSPORT=local
ERP_MCP_URL=
ERP_MCP_TOKEN=
ERP_MCP_LOCAL_COMMAND="php artisan mcp:start fake-erp"
ERP_MCP_TIMEOUT=30
# Estado do servidor falso (apagar o ficheiro repõe as fixtures)
ERP_FAKE_STORAGE_PATH=

# Email — [CONFIRMAR] provedor (docs/SPEC.md secção 21, #1)
MAIL_INBOUND_PROVIDER=
MAIL_INBOUND_SIGNING_KEY=
MAIL_DOMAIN=

# Limites (E02)
AI_MONTHLY_BUDGET_USD=
AI_RUN_MAX_TOKENS=
